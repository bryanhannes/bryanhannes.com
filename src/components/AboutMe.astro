---
import { translations, type Lang } from '../i18n/translations';

interface Props {
    lang?: Lang;
}

const { lang = 'nl' } = Astro.props;
const t = translations[lang];
---

<section class="mt-6 p-6 rounded-xl bg-[#0B0F1A]">
    <h2 class="text-xl font-bold mb-6">{t.about.title}</h2>

    <div class="space-y-4 text-gray-300 max-w-3xl">
        {t.about.paragraphs.map(paragraph => (
            <p>{paragraph}</p>
        ))}
    </div>
</section>
