---

<div class="p-6 rounded-xl bg-[#0B0F1A] h-full">
    <h2 class="text-xl font-bold mb-6">{t.toolbox.title}</h2>

    <div class="grid grid-cols-3 gap-4">
        {tools.map(tool => (
                <div class="flex flex-col items-center">
                    <div class={`w-16 h-16 rounded-xl ${tool.bgColor} flex items-center justify-center p-3 mb-2`}>
                        <Fragment set:html={renderIcon(tool.icon)} />
                    </div>
                    <span class="text-sm">{tool.name}</span>
                </div>
        ))}
    </div>
</div>
