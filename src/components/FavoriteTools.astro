---
import { translations, type Lang } from '../i18n/translations';

interface Props {
    lang?: Lang;
}

const { lang = 'nl' } = Astro.props;
const t = translations[lang];

const tools = [
    {
        name: "Angular",
        icon: "angular",
        bgColor: "bg-gray-800"
    },
    {
        name: "TypeScript",
        icon: "typescript",
        bgColor: "bg-gray-800"
    },
    {
        name: "NX",
        icon: "nx",
        bgColor: "bg-gray-800"
    },
    {
        name: "NodeJS",
        icon: "nodejs",
        bgColor: "bg-gray-800"
    },
    {
        name: "Docker",
        icon: "docker",
        bgColor: "bg-gray-800"
    },
    {
        name: "Google Cloud",
        icon: "googlecloud",
        bgColor: "bg-gray-800"
    }
];

// Function to render the appropriate icon based on the icon type
