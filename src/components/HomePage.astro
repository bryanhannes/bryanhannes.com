---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import ProfileCard from './ProfileCard.astro';
import Timeline from './Timeline.astro';
import FavoriteTools from './FavoriteTools.astro';
import SaaSProducts from './SaaSProducts.astro';
import YoutubeVideos from './YoutubeVideos.astro';
import AboutMe from './AboutMe.astro';
import { translations, type Lang } from '../i18n/translations';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<Layout title={t.meta.title} description={t.meta.description} lang={lang}>
	<Header lang={lang} />

	<main class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
		<!-- First column - Profile Card -->
		<div class="lg:col-span-1 h-full">
			<ProfileCard class="h-full" lang={lang} />
		</div>

		<!-- Second column - Timeline and Favorite Tools -->
		<div class="lg:col-span-1 h-full flex flex-col">
			<div class="flex-grow mb-6">
				<Timeline lang={lang} />
			</div>
			<div class="flex-grow">
				<FavoriteTools lang={lang} />
			</div>
		</div>

		<!-- Third column - SaaS Products -->
		<div class="lg:col-span-1 h-full">
			<SaaSProducts class="h-full" lang={lang} />
		</div>
	</main>

	<AboutMe lang={lang} />

	<YoutubeVideos lang={lang} />
</Layout>
